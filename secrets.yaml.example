# Copy to secrets.yaml (gitignored) and fill in your own values.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
fallback_ap_password: "fallback-hotspot-password"

# Per-device API encryption keys (generate: https://esphome.io/components/api.html)
irrigation_api_key: "base64-encryption-key=="
bme680_s3_api_key: "base64-encryption-key=="
bme680_api_key: "base64-encryption-key=="

# Per-device OTA passwords
irrigation_ota_password: "ota-password"
bme680_s3_ota_password: "ota-password"
bme680_ota_password: "ota-password"
